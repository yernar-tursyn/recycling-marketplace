л"}],["$","li",null,{"children":"Размещения незаконного контента"}],["$","li",null,{"children":"Выдачи себя за другое лицо или организацию"}],["$","li",null,{"children":"Сбора или отслеживания личной информации других пользователей"}],["$","li",null,{"children":"Вмешательства в работу сервиса"}]]}],["$","h2",null,{"children":"6. Прекращение действия"}],["$","p",null,{"children":"Мы можем прекратить или приостановить доступ к нашему сервису немедленно, без предварительного уведомления или ответственности, по любой причине, включая, без ограничений, нарушение условий."}],["$","h2",null,{"children":"7. Ограничение ответственности"}],["$","p",null,{"children":"В максимальной степени, разрешенной законом, мы не несем ответственности за любые прямые, косвенные, случайные, особые, последующие или штрафные убытки, возникающие в результате использования или невозможности использования сервиса."}],["$","h2",null,{"children":"8. Контактная ин��ормация"}],["$","p",null,{"children":"Если у вас есть вопросы об условиях использования, пожалуйста, свяжитесь с нами по адресу: info@ecomarket.ru"}]]}]]}]],null],null]},["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","terms","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"ru","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","title",null,{"children":"ЭкоМаркет - платформа для переработки вторсырья"}],["$","meta",null,{"name":"description","content":"Платформа для сдачи и приема вторсырья"}]]}],["$","body",null,{"children":["$","$L4",null,{"attribute":"class","defaultTheme":"system","enableSystem":true,"disableTransitionOnChange":true,"children":["$","$L5",null,{"children":["$","$L6",null,{"children":["$","$L7",null,{"children":["$","div",null,{"classN